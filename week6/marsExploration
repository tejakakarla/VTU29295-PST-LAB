class Result {

    public static int marsExploration(String s) {

        int changes = 0;

        for (int i = 0; i < s.length(); i++) {

            char expected;

            if (i % 3 == 0) {
                expected = 'S';
            } else {
                expected = 'O';
            }

            if (s.charAt(i) != expected) {
                changes++;
            }
        }

        return changes;
    }
}
